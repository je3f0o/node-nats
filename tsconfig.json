{
  "compilerOptions": {
    "target"                           : "esnext",
    "module"                           : "nodenext",
    "moduleResolution"                 : "nodenext",
    "esModuleInterop"                  : true,
    "forceConsistentCasingInFileNames" : true,
    "strict"                           : true,
    "skipLibCheck"                     : true,

    "types": ["node"],

    "outDir": "./dist",
    "rootDir": "./src",

    "declaration": true,
    "emitDeclarationOnly": false,

    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}